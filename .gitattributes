# 内核项目必须统一 LF：CRLF 会让 patch 每行都变，format-patch 全是脏 diff
* text=auto eol=lf

*.sh    text eol=lf
*.md    text eol=lf
*.yml   text eol=lf
*.yaml  text eol=lf
*.fragment text eol=lf
*.c     text eol=lf
*.h     text eol=lf

# Windows 脚本保持 CRLF
*.ps1   text eol=crlf
*.bat   text eol=crlf
*.cmd   text eol=crlf

# 二进制
*.png   binary
*.jpg   binary
*.gz    binary
*.xz    binary
