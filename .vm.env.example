# 虚拟机连接配置（复制为 .vm.env 后填写）
#
# 获取虚拟机 IP：在 openEuler 里执行 hostname -I
#
# VMware 网络模式说明：
#   NAT    —— 虚拟机 IP 是内网段（如 192.168.x.x），宿主通常能直接访问
#   桥接   —— 虚拟机与宿主同网段，直接填虚拟机 IP
#   仅主机 —— 只能在宿主上访问，正好够用

VM_HOST=192.168.1.50
VM_USER=root
VM_PORT=22

# 用密钥登录（推荐）。留空则走密码 / ssh-agent
# 生成密钥：ssh-keygen -t ed25519
# 拷公钥进虚拟机：type $env:USERPROFILE\.ssh\id_ed25519.pub | ssh root@<ip> "cat >> ~/.ssh/authorized_keys"
VM_KEY=C:\Users\Administrator\.ssh\id_ed25519
